#!/bin/bash
# Percona XtraBackup DEB post-install
set -e

case "$1" in
    configure)
        if [[ -f /tmp/call-home.sh ]]; then
            bash /tmp/call-home.sh \
                -f "PRODUCT_FAMILY_PXB" \
                -v "@XB_VERSION_MAJOR@.@XB_VERSION_MINOR@.@XB_VERSION_PATCH@@XB_VERSION_EXTRA@-@DEB_RELEASE@" \
                -d "PACKAGE" &>/dev/null || :
            rm -f /tmp/call-home.sh
        fi
        ;;
esac

exit 0
