#!/usr/bin/make -f
# -*- makefile -*-

#export DH_VERBOSE=1

NCPU := $(shell nproc)

DEB_HOST_MULTIARCH ?= $(shell dpkg-architecture -qDEB_HOST_MULTIARCH)

builddir      := release
builddirdebug := debug
rpath         := '$$ORIGIN/../lib/private'

# Common cmake flags shared between release and debug builds
CMAKE_COMMON_FLAGS := \
	-DBUILD_CONFIG=xtrabackup_release \
	-DCMAKE_INSTALL_PREFIX=/usr \
	-DWITH_SSL=system \
	-DINSTALL_MYSQLTESTDIR=/usr/share/percona-xtrabackup-test-80 \
	-DINSTALL_MANDIR=/usr/share/man \
	-DWITH_MAN_PAGES=1 \
	-DMINIMAL_RELWITHDEBINFO=OFF \
	-DDOWNLOAD_BOOST=1 \
	-DWITH_BOOST=libboost \
	-DMYSQL_UNIX_ADDR=/var/run/mysqld/mysqld.sock \
	-DOPENSSL_ROOT_DIR=/usr/lib/$(DEB_HOST_MULTIARCH) \
	-DINSTALL_PLUGINDIR=lib/xtrabackup/plugin \
	-DFORCE_INSOURCE_BUILD=1 \
	-DWITH_ZLIB=bundled \
	-DWITH_ZSTD=bundled \
	-DWITH_PROTOBUF=bundled

override_dh_auto_configure:
ifeq "$(DEB_DUMMY)" ""
	mkdir -p $(builddirdebug) $(builddir)
	cd $(builddirdebug) && cmake .. $(CMAKE_COMMON_FLAGS) -DCMAKE_BUILD_TYPE=Debug
	cd $(builddir)      && cmake .. $(CMAKE_COMMON_FLAGS)
else
	echo 'int main() { return 300; }' | gcc -x c - -o xtrabackup
	echo 'int main() { return 300; }' | gcc -x c - -o xbstream
	echo 'int main() { return 300; }' | gcc -x c - -o xbcrypt
	echo 'int main() { return 300; }' | gcc -x c - -o xbcloud
endif

override_dh_auto_build:
ifeq "$(DEB_DUMMY)" ""
	$(MAKE) -C $(builddirdebug) -j$(NCPU)
	$(MAKE) -C $(builddir) -j$(NCPU)
endif

override_dh_builddeb:
	dh_builddeb -- -Zgzip

override_dh_auto_install:
	cd $(builddir) && $(MAKE) install DESTDIR=$(CURDIR)/debian/tmp

override_dh_install:
	dh_install
	mkdir -p debian/percona-xtrabackup-80/usr/lib/private/
	cp ./$(builddir)/library_output_directory/libprotobuf-lite.so* \
		debian/percona-xtrabackup-80/usr/lib/private/
	cp ./$(builddirdebug)/runtime_output_directory/xtrabackup \
		debian/percona-xtrabackup-80/usr/bin/xtrabackup-debug
	patchelf --set-rpath $(rpath) debian/percona-xtrabackup-80/usr/bin/xtrabackup-debug

override_dh_strip:
	dh_strip --dbg-package=percona-xtrabackup-dbg-80
	dh_strip -Xlibprotobuf-lite

%:
	dh $@
